# Cobo Agentic Wallet（服务端）
AGENT_WALLET_ENV=dev
# dev: https://api-core.agenticwallet.dev.cobo.com
# prod: https://api-core.agenticwallet.cobo.com
AGENT_WALLET_API_URL=https://api-core.agenticwallet.dev.cobo.com
# 可选：通常不需要手动配置。优先复用 settings / CLI onboard 后的 API Key；
# 仅当三者皆无时才会 POST /api/v1/principals/provision。
# 只有在你想复用既有 CAW Agent 凭证或跳过自动 provision 时才填写。
# AGENT_WALLET_API_KEY=

# 创建 MPC 钱包时使用的 Agent TSS 节点 ID；当前方案：TSS Node 跑在当前 Hermes Agent 主机
# 前端最终部署到 Vercel，因此 Vercel 不能假设自己能运行 TSS；需要通过远程后端/tunnel 调用这台主机。
AGENT_WALLET_TSS_RUNTIME=hermes-agent-host
AGENT_WALLET_MAIN_NODE_ID=

# 策略层：调用当前 Hermes Agent 主机上的 Hermes runtime（替代 Z.AI API）
# 本机开发可用 cli；Vercel 部署必须使用 api，并把 HERMES_API_URL 配成公网/隧道可访问地址。
HERMES_STRATEGY_MODE=api
HERMES_CLI_BIN=hermes
HERMES_PROFILE=default
# 可选：指定 Hermes 模型；留空则使用 Hermes 默认配置
HERMES_STRATEGY_MODEL=
# 例：https://<your-tunnel-or-vps-domain>/hermes-api 或 https://<domain>/v1 的上一级
HERMES_API_URL=
# 服务端调用 Hermes API Server 的 Bearer Key；不要暴露到前端
HERMES_API_KEY=

# 本机 dev 默认走 cli-onboard（caw onboard → TSS bootstrap → active → pair）
# CAW_CLI_BIN=caw

# 仅在 Hermes 主机已安装 caw CLI 且希望复用当前已配对钱包时启用
# CAW_ADOPT_EXISTING_WALLET=true
# CAW_EXISTING_EVM_ADDRESS=

# 前端通过 GET /api/wallet/preparation/agent-status 每 5s 轮询 bootstrap 进度（最多 24 次）
